      "axios": "^1.7.2",
      "dompurify": "^3.1.5",
      "i18next": "^23.11.5",
      "i18next-browser-languagedetector": "^8.0.0",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "react-i18next": "^14.1.2",
      "react-redux": "^9.1.2",
      "react-router-dom": "^6.24.0",
      "redux-persist": "^6.0.0"
    },
    "devDependencies": {
      "@babel/core": "^7.24.7",
